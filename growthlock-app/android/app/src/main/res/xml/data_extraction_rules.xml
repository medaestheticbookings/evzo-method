<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer read these instead of backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="growthlock.xml" />
        <include domain="database" path="." />
        <include domain="file" path="app_webview" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="growthlock.xml" />
        <include domain="database" path="." />
        <include domain="file" path="app_webview" />
    </device-transfer>
</data-extraction-rules>
